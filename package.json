{
  "name": "lepis",
  "version": "1.0.0",
  "description": "A lightweight, local-first PDF editor for macOS",
  "main": "./out/main/index.js",
  "author": "Nicolò Bruno",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "node --test tests/*.test.mjs",
    "test:chat": "pnpm build && electron tests/credentials.integration.mjs && electron tests/auth.integration.mjs && electron tests/chat.integration.mjs",
    "test:text": "pnpm build && electron tests/text.integration.mjs",
    "test:highlight": "pnpm build && electron tests/highlight.integration.mjs",
    "test:annotations": "pnpm build && electron tests/annotation-loading.integration.mjs",
    "test:images": "pnpm build && electron tests/images.integration.mjs",
    "test:memory": "pnpm build && electron tests/tabs-memory.integration.mjs",
    "test:documents": "pnpm build && electron tests/documents.integration.mjs",
    "test:sidebar": "pnpm build && electron tests/sidebar.integration.mjs",
    "test:search": "pnpm build && electron tests/search.integration.mjs",
    "test:view-layout": "pnpm build && electron tests/view-layout.integration.mjs",
    "test:zoom": "pnpm build && electron tests/zoom.integration.mjs",
    "test:keyboard-scroll": "pnpm build && electron tests/keyboard-scroll.integration.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:mac": "pnpm run build && electron-builder --mac",
    "test:recovery": "pnpm build && electron tests/recovery.integration.mjs && electron tests/lazy-recovery.integration.mjs",
    "test:annotation-performance": "pnpm build && electron tests/annotation-performance.integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@google/genai": "^2.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^1.54.0",
    "openai": "^7.34.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "^1.6.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
